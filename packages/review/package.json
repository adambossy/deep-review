{
  "name": "@deep-review/review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "pr-review": "./dist/cli.js"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "build": "tsup src/index.ts src/cli.ts --format esm --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deep-review/call-graph": "workspace:*",
    "@deep-review/pr": "workspace:*",
    "@deep-review/slicer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
